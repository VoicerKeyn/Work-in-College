#include <stdio.h>
#include <locale.h>
int main(){
	int n;
	char c1,c2;
	//Сканируем число N
	scanf("%d",&n);
	//Проверяем его на четность, если четное то сканируем символы, если нет то заканчиваем программу
	if(n%2==0){
		scanf(" %c",&c1);
		scanf(" %c",&c2);
	}
	else{
		printf("not chet");
		return 0;
	}
	int i=0;
	//Печатаем строку N-длинны чередуя символы c1,c2
	while(i<n){
		printf("%c ",c1);
		printf("%c ",c2);
		i = i+1;
	}
}
