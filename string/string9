#include <stdio.h>
#include <locale.h>
#define AR_LEN 100
int main(){
	int n;
	char c1,c2;
	char str[AR_LEN];
	//Сканируем число N
	scanf("%d",&n);
	//Проверяем его на четность, если четное то сканируем символы, если нет то заканчиваем программу
	if(n%2==0){
		scanf(" %c",&c1);
		scanf(" %c",&c2);
	}
	else{
		printf("not chet");
		return 0;
	}
	int i=0;
	//Печатаем строку N-длинны чередуя символы c1,c2
	while(i<n){
		if(i%2==0){
			str[i] = c1;
		}
		else{
			str[i] = c2;
		}
		i = i+1;
	}
	str[i] = '\0';
	printf("%s\n",str);
return 0;
}
